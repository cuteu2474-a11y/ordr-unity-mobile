{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "원랜디 2.323 캐릭터 상세 스킬 프로필",
  "type": "object",
  "required": [
    "gameVersion",
    "catalogVersion",
    "specCompleteness",
    "profiles"
  ],
  "properties": {
    "gameVersion": {
      "const": "S2 2.323[C]"
    },
    "catalogVersion": {
      "const": "2.323"
    },
    "specCompleteness": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unitId",
          "sourceUrl",
          "skills",
          "passives",
          "basicAttack",
          "skillSpecCompleteness",
          "gameRawCode",
          "unconfirmedFields"
        ],
        "properties": {
          "unitId": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "trigger",
                "components"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                },
                "components": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "passives": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "enhancedChanges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "enhancedCondition": {
            "type": "object"
          },
          "enhancedDescription": {
            "type": "string"
          },
          "basicAttack": {
            "type": "object"
          },
          "gameRawCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "skillSpecCompleteness": {
            "enum": [
              "partial",
              "complete"
            ]
          },
          "unconfirmedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertaintyNotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stackMilestones": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "clearCountScaling": {
            "type": "object"
          },
          "satellites": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "skillTriggeredBuffs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "fusionMilestones": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "acquisition": {
            "type": "object"
          },
          "verifiedAttackRange": {
            "type": "number",
            "minimum": 0
          },
          "sourceStatus": {
            "enum": [
              "secondary-needs-2.323-check",
              "primary-2.323"
            ]
          },
          "expectedPrimarySourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "basicAttackVerificationStatus": {
            "enum": [
              "original-confirmed",
              "unverified",
              "not-collected"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "collectedOn": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "warning": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
